{
  "name": "dsh-desk",
  "productName": "DSH Desk",
  "version": "0.1.0",
  "description": "DSH Desk - a desktop pet companion and local usage workbench for DeepSeek Harness.",
  "author": "Renakoni",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-electron/main/index.js",
  "scripts": {
    "prebuild": "npm pack ./dsh-plugin --pack-destination ./build",
    "postinstall": "node node_modules/electron/install.js",
    "dev": "vite --host 127.0.0.1 --port 5273 --strictPort",
    "build:electron": "tsc -p tsconfig.node.json && tsc -p tsconfig.preload.json",
    "dev:electron": "npm run build:electron && concurrently -k \"npm run dev\" \"wait-on tcp:5273 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5273 electron .\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "npm run build:electron && vite build",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "test": "vitest run",
    "hook:forward": "node scripts/hook-forwarder.js",
    "hook:doctor": "node scripts/hook-doctor.js"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "lucide-react": "^0.479.0",
    "node-html-parser": "^7.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.3"
  }
}
